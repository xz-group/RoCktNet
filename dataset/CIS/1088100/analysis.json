  "paper_metadata": {
    "title": "A Fully Integrated Low-IF CMOS GPS Radio With On-Chip Analog Image Rejection",
    "authors": [
      "Farbod Behbahani",
      "Hamid Firouzkouhi",
      "Ramesh Chokkalingam",
