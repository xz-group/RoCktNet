  "paper_metadata": {
    "title": "An Integrated 200-W Class-D Audio Amplifier",
    "authors": [
      "Marco Berkhout"
    ],
    "abstract": "An integrated stereo class-D audio power amplifier realized in a silicon-on-insulator (SOI)-based BCD technology is presented. The amplifier is capable of delivering 2 100 W in two 4loads at a supply voltage of 60 V. A second-order feedback loop is used to supress supply ripple and pulse-shape errors in the switching power stage. The limiting factor in the performance of any class-D amplifiers is the quality of the switching power stage. A high-speed low-current levelshifter and a robust deadtime control arrangement are proposed that enable the realization of a robust high-quality switching power stage. Some practical issues with respect to robustness and electromagnetic compatibility are disFig. 1. Cross section of HV-DMOS in A-BCD. cussed.",
    "keywords": [
      "Audio amplifiers",
      "power integrated circuits"
    ],
    "doi": "10.1109/JSSC.2003.813238",
    "venue": "IEEE JOURNAL OF SOLID-STATE CIRCUITS",
    "year": 2003
  },
