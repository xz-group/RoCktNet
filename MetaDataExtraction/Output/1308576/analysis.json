  "paper_metadata": {
    "title": "A CMOS 10-Gb/s SONET Transceiver",
    "authors": [
      "Harish S. Muthali",
      "Thomas P. Thomas",
      "Ian A. Young"
    ],
    "abstract": "This paper presents a single-chip SONET OC-192 90-nm CMOS PROCESS PARAMETERS transceiver (transmitter and receiver) fabricated in a 90-nm mixed-signal CMOS process. The transmitter consists of a 10-GHz clock multiplier unit (CMU), 16:1 multiplexer, and 10-Gb/s output buffer. The receiver consists of a 10-Gb/s limiting input amplifier, clock and data recovery circuit (CDR), 1:16 demultiplexer, and drivers for low-voltage differential signal (LVDS) outputs. Both transmit and receive phase-locked loops employ a 10-GHz on-chip LC voltage-controlled oscillator (VCO). This transceiver exceeds all SONET OC-192 specifications with ample margin. Jitter generation at 10.66-Gb/s data rate is 18 mUIpp (unit interval, peak-to-peak) and jitter tolerance is 0.6 UIpp at 4-MHz jitter frequency. This transceiver requires 1.2 V for the core logic and 1.8 V for input/output LVDS buffers. Multiple power supply domains are implemented here to mitigate crosstalk between receiver and transmitter. The overall power dissipation of this chip is 1.65 W.",
    "keywords": [
      "Clock and data recovery (CDR)",
      "CMOS integrated circuits",
      "LC VCO",
      "optical communication",
      "phase-locked loops",
      "SONET OC-192",
      "transceiver"
    ],
    "doi": "10.1109/JSSC.2004.829935",
    "venue": "IEEE JOURNAL OF SOLID-STATE CIRCUITS",
    "year": 2004
  },
